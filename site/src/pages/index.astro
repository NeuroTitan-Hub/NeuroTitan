---
import Base from "../layouts/Base.astro";
import Ticker from "../components/Ticker.astro";
import PostList from "../components/PostList.astro";
import FieldIcon from "../components/FieldIcon.astro";
import { FIELDS, PILLARS, PRINCIPLES, PRODUCTS, SITE, TOOLS, CAMPUS_AMBASSADOR_FORM } from "../data/site";
import { getPublishedPosts } from "../lib/posts";
import { getOrgStats } from "../lib/github";
import titan from "../data/titan-nano.json";

const allPosts = await getPublishedPosts();
const posts = allPosts.slice(0, 3);
const stats = await getOrgStats();
const featured = PRODUCTS.slice(0, 4);
const sample = titan.samples[0];
const gainPct = ((1 - titan.test.int8.bpc / titan.baselines.test_bpc_best_order) * 100).toFixed(0);
const titanParams = (titan.params / 1e6).toFixed(1);
const published = allPosts.filter((p) => !p.data.draft).length;

// The word after "Research you can" cycles through these. The first one is what readers without
// JavaScript, screen readers and search engines get.
const words = ["rerun.", "check.", "measure.", "build on."];

// Where each field sits once the core splits, and what it is working on now.
const orbs = {
  ai: { x: 0, y: -1, tag: "Titan-nano · post 1", hue: "red" },
  semiconductors: { x: 0.87, y: 0.5, tag: "sky130 · open EDA", hue: "amber" },
  quantum: { x: -0.87, y: 0.5, tag: "QML-benchmarks", hue: "blue" },
} as const;

const numbers = [
  { label: "Public repositories", value: stats.publicRepos, src: `GitHub · ${SITE.githubOrg} · ${stats.fetchedAt}` },
  { label: "Posts published", value: published, src: "This site" },
  { label: "Research fields", value: FIELDS.length, src: "ML · semiconductors · quantum" },
  { label: "Products in progress", value: PRODUCTS.filter((p) => p.kind === "dev").length, src: "See products" },
];
---

<Base>
  <!-- 1. HERO: dark stage, signal streaming out of one point -->
  <section class="hero t-graphite">
    <canvas class="warp" data-warp aria-hidden="true"></canvas>
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <p class="eyebrow label"><span class="dash" aria-hidden="true"></span>NeuroTitan Labs · independent research</p>
      <h1 class="hero-title" aria-label={`Research you can ${words[0]}`}>
        <span aria-hidden="true">Research you can</span>
        <span class="swap" aria-hidden="true" data-words={JSON.stringify(words)}>{words[0]}</span>
      </h1>
      <p class="lede hero-lede">
        We work on machine learning, chip design and quantum computing. Every result ships with the code, data and
        random seeds that produced it, and we publish what did not work next to what did.
      </p>
      <div class="actions">
        <a class="btn btn--light" href="/ai">Explore NeuroTitan AI <span aria-hidden="true">→</span></a>
        <a class="btn btn--glass" href="/research">Research areas</a>
      </div>
    </div>
    <div class="wrap facts">
      <div><strong>Code</strong><span>with every result</span></div>
      <div><strong>Data</strong><span>and the random seeds</span></div>
      <div><strong>Failures</strong><span>published next to successes</span></div>
    </div>
  </section>

  <Ticker items={TOOLS} label="Tools we use" />

  <!-- 2. ONE LAB, THREE FIELDS: a core that splits as you scroll -->
  <section class="orbit t-graphite" data-orbit aria-labelledby="orbit-title">
    <div class="orbit-stage" data-orbit-stage>
      <p class="orbit-kicker label">One lab</p>
      <div class="core" aria-hidden="true"></div>
      {
        FIELDS.map((f) => {
          const o = orbs[f.id];
          return (
            <a
              class={`orb orb--${o.hue}`}
              href={f.href}
              style={`--x:${o.x};--y:${o.y}`}
              aria-label={`${f.name}: ${o.tag}`}
            >
              <span class="glow" aria-hidden="true" />
              <span class="orb-label">
                <strong>{f.name}</strong>
                <small>{o.tag}</small>
              </span>
            </a>
          );
        })
      }
      <h2 id="orbit-title" class="orbit-title">Three fields,<br />one standard of evidence.</h2>
    </div>
  </section>

  <!-- 3. FIELDS: numbered rows with moving line drawings -->
  <section class="section fields-sec">
    <div class="wrap">
      <div class="section-head section-head--split" data-reveal>
        <div>
          <p class="label">01 · Fields</p>
          <h2>What we work on</h2>
        </div>
        <p class="lede">
          A result is not finished until someone other than its author has rerun it from the published code and got
          the same numbers.
        </p>
      </div>
      <ol class="rows">
        {
          FIELDS.map((f) => (
            <li class="row" data-reveal>
              <a href={f.href}>
                <span class="row-num label">{f.index}</span>
                <div class="row-text">
                  <h3>{f.name}</h3>
                  <p>{f.summary}</p>
                  <ul class="chips" aria-label="Tools">
                    {f.tools.slice(0, 4).map((t) => (
                      <li>{t}</li>
                    ))}
                  </ul>
                </div>
                <div class="row-art">
                  <FieldIcon id={f.id} />
                </div>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 4. AI: graphite with a console -->
  <section class="section t-graphite ai">
    <div class="ai-glow" aria-hidden="true"></div>
    <div class="wrap ai-grid">
      <div data-reveal>
        <p class="label">02 · NeuroTitan AI</p>
        <h2>Titan-nano: our first model, built from scratch</h2>
        <p class="lede">
          A {titanParams}-million-parameter transformer we designed and trained in-house on Python code. On code it never
          saw, it needs {gainPct}% fewer bits per character than the best classical model. It runs in your browser on our
          own inference engine, and you can watch its real attention as it writes.
        </p>
        <div class="actions">
          <a class="btn btn--light" href="/ai#demo">Try Titan-nano <span aria-hidden="true">→</span></a>
          <a class="btn btn--glass" href="/ai#results">See the results</a>
        </div>
      </div>
      <div class="console" data-reveal aria-label="A real completion from Titan-nano">
        <div class="console-bar"><i></i><i></i><i></i><span>titan-nano · unedited sample · temperature {sample.temperature} · seed {sample.seed}</span></div>
        <pre class="console-body sample"><span class="prompt-text">{sample.prompt}</span><span class="gen">{sample.completion}</span></pre>
      </div>
    </div>
  </section>

  <!-- 5. PRODUCTS -->
  <section class="section">
    <div class="wrap">
      <div class="section-head section-head--split" data-reveal>
        <div>
          <p class="label">03 · Products</p>
          <h2>What we are building</h2>
        </div>
        <p class="lede">Each one is labelled with where it really stands.</p>
      </div>
      <div class="products">
        {
          featured.map((p) => (
            <article class="product" data-reveal>
              <header>
                <h3>{p.name}</h3>
                <span class={`pill pill--${p.kind}`}>{p.status}</span>
              </header>
              <p>{p.summary}</p>
              <p class="links">
                {p.links.map((l) => (
                  <a href={l.href} rel={l.href.startsWith("http") ? "noopener" : undefined}>
                    {l.label} →
                  </a>
                ))}
              </p>
            </article>
          ))
        }
      </div>
      <p class="all"><a href="/products">All products →</a></p>
    </div>
  </section>

  <!-- 6. NUMBERS: computed at build time, count up on screen -->
  <section class="section t-concrete">
    <div class="wrap">
      <div class="section-head section-head--split" data-reveal>
        <div>
          <p class="label">04 · The lab in numbers</p>
          <h2>Counted, not claimed</h2>
        </div>
        <p class="lede">
          Computed when the site is built, from GitHub and from this site's own content. Nothing here is typed in by
          hand.
        </p>
      </div>
      <dl class="big-numbers" data-reveal>
        {
          numbers.map((n) => (
            <div>
              <dt>{n.label}</dt>
              <dd class="big" data-count={n.value ?? undefined}>{n.value ?? "—"}</dd>
              <dd class="src">{n.src}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- 7. BLOG -->
  <section class="section">
    <div class="wrap">
      <div class="section-head section-head--split" data-reveal>
        <div>
          <p class="label">05 · Blog</p>
          <h2>From the lab notebook</h2>
        </div>
        <p class="lede">Two posts a week when they are ready. A post that is not ready waits.</p>
      </div>
      {
        posts.length > 0 ? (
          <PostList posts={posts} />
        ) : (
          <p class="muted">The first posts are being run and checked now.</p>
        )
      }
    </div>
  </section>

  <!-- 8. HOW WE WORK -->
  <section class="section dots">
    <div class="wrap two-col">
      <div class="section-head" data-reveal>
        <p class="label">06 · How we work</p>
        <h2>The rules every result follows</h2>
      </div>
      <ol class="principles" data-reveal>
        {
          [...PRINCIPLES, ...PILLARS].slice(0, 6).map((p, i) => (
            <li>
              <span class="p-num">{String(i + 1).padStart(2, "0")}</span>
              <div>
                <h3>{p.title}</h3>
                <p>{p.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 9. JOIN: a panel with a rippling field -->
  <section class="section join-sec">
    <div class="wrap">
      <div class="join-panel" data-reveal>
        <div class="join-text">
          <p class="label label--red">07 · Join the lab</p>
          <h2>Rerun our work.<br /><span class="soft">Or build the next one with us.</span></h2>
          <ul class="join-list">
            <li>
              <span class="label">GitHub</span>
              <a href={SITE.github} rel="noopener">Every repository is public. Issues and pull requests welcome ↗</a>
            </li>
            <li>
              <span class="label">Campus ambassadors</span>
              <a href={CAMPUS_AMBASSADOR_FORM} rel="noopener">Represent the lab and run sessions at your college ↗</a>
            </li>
            <li>
              <span class="label">Corrections</span>
              <a href={`mailto:${SITE.email}`}>Found an error? {SITE.email}</a>
            </li>
          </ul>
        </div>
        <canvas class="wave" data-wave aria-hidden="true"></canvas>
      </div>
    </div>
  </section>
</Base>

<script>
  import "../scripts/home";
</script>

<style>
  /* ---------- shared ---------- */
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1.35rem;
    border-radius: 999px;
    font-family: var(--sans);
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    transition: transform 180ms ease, background-color 180ms ease, border-color 180ms ease, color 180ms ease;
  }

  .btn:hover {
    transform: translateY(-2px);
  }

  .btn--light {
    background: var(--ink);
    color: var(--paper);
    box-shadow: 0 8px 24px -10px rgba(229, 87, 78, 0.55);
  }

  .btn--light:hover {
    color: var(--paper);
    background: #fff;
  }

  .btn--glass {
    color: var(--ink);
    border: 1px solid rgba(236, 232, 225, 0.22);
    background: rgba(236, 232, 225, 0.06);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  .btn--glass:hover {
    color: var(--ink);
    border-color: var(--red);
  }

  /* ---------- 1. hero ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    min-height: 100svh;
    display: grid;
    grid-template-rows: 1fr auto;
    isolation: isolate;
  }

  .warp {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(15, 15, 15, 0.92) 0%, rgba(15, 15, 15, 0.55) 45%, rgba(15, 15, 15, 0) 75%),
      linear-gradient(0deg, rgba(15, 15, 15, 1) 0%, rgba(15, 15, 15, 0) 22%);
  }

  .hero-inner {
    align-self: center;
    display: grid;
    gap: 1.6rem;
    width: 100%;
    padding-block: clamp(3rem, 8vh, 6rem) 2rem;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .dash {
    width: 2.5rem;
    height: 1px;
    background: var(--red);
  }

  .hero-title {
    display: grid;
    font-size: clamp(3rem, 9vw, 7.25rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 0.98;
    max-width: 12ch;
  }

  .swap {
    color: var(--red);
    font-style: italic;
    min-height: 1em;
    white-space: nowrap;
  }

  .hero-lede {
    max-width: 36rem;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    width: 100%;
    padding-block: 1.5rem 2.25rem;
    border-top: 1px solid var(--rule);
  }

  .facts div {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .facts strong {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1;
  }

  .facts span {
    font-family: var(--mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--grey);
  }

  /* ---------- 2. orbit scene ----------
     Default (no JS, reduced motion): final state, one screen tall.
     With JS (.is-live): a tall section whose stage sticks while the core splits. */
  .orbit {
    position: relative;
    border-top: 1px solid var(--rule);
  }

  .orbit.is-live {
    height: 320vh;
  }

  .orbit-stage {
    --grow: 1;
    --split: 1;
    --labels: 1;
    --text: 1;
    --R: min(26vmin, 14rem);
    position: relative;
    height: 100svh;
    min-height: 34rem;
    overflow: hidden;
    display: grid;
    place-items: center;
  }

  .orbit.is-live .orbit-stage {
    position: sticky;
    top: 0;
  }

  .orbit-kicker {
    position: absolute;
    top: calc(var(--header-h) + 1.5rem);
    left: 50%;
    transform: translateX(-50%);
    opacity: calc(1 - var(--text));
  }

  .core,
  .orb {
    position: absolute;
    left: 50%;
    top: 50%;
  }

  .core {
    width: 9rem;
    height: 9rem;
    margin: -4.5rem 0 0 -4.5rem;
    border-radius: 50%;
    background: radial-gradient(circle, #fff 0%, #f3b2a9 18%, #e5574e 42%, rgba(229, 87, 78, 0) 70%);
    filter: blur(2px);
    transform: scale(calc(0.4 + 0.9 * var(--grow) - 0.5 * var(--split)));
    opacity: calc(1 - 0.85 * var(--split));
    animation: breathe 3.2s ease-in-out infinite;
  }

  @keyframes breathe {
    50% {
      filter: blur(6px) brightness(1.15);
    }
  }

  .orb {
    width: 0;
    height: 0;
    text-decoration: none;
    color: var(--ink);
    transform: translate(calc(var(--x) * var(--R) * var(--split)), calc(var(--y) * var(--R) * var(--split) - 2rem));
    opacity: calc(var(--split) * 1.4);
  }

  .glow {
    position: absolute;
    width: 6.5rem;
    height: 6.5rem;
    left: -3.25rem;
    top: -3.25rem;
    border-radius: 50%;
    background: radial-gradient(circle, #fff 0%, var(--c1) 25%, var(--c2) 48%, transparent 70%);
    transition: transform 300ms ease;
    animation: breathe 3.2s ease-in-out infinite;
  }

  .orb:hover .glow,
  .orb:focus-visible .glow {
    transform: scale(1.15);
  }

  .orb--red {
    --c1: #f3b2a9;
    --c2: rgba(229, 87, 78, 0.85);
  }

  .orb--amber {
    --c1: #f6dca6;
    --c2: rgba(217, 155, 52, 0.85);
  }

  .orb--blue {
    --c1: #c9d6ff;
    --c2: rgba(96, 128, 230, 0.85);
  }

  .orb-label {
    position: absolute;
    top: 3.6rem;
    left: 0;
    transform: translateX(-50%);
    display: grid;
    justify-items: center;
    gap: 0.15rem;
    white-space: nowrap;
    opacity: var(--labels);
  }

  .orb-label strong {
    font-weight: 500;
    font-size: 1.05rem;
  }

  .orb-label small {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--grey);
  }

  .orbit-title {
    position: absolute;
    bottom: clamp(2rem, 8vh, 5rem);
    left: 0;
    right: 0;
    text-align: center;
    font-size: clamp(1.8rem, 4.2vw, 3.25rem);
    padding-inline: var(--gutter);
    opacity: var(--text);
    transform: translateY(calc((1 - var(--text)) * 1.5rem));
  }

  /* ---------- 3. field rows ---------- */
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .row a {
    display: grid;
    grid-template-columns: 4rem 1fr 11rem;
    gap: 1.5rem 2rem;
    align-items: center;
    padding: clamp(1.4rem, 3vw, 2.25rem);
    border-radius: 1.5rem;
    border: 1px solid var(--rule);
    background: rgba(255, 255, 255, 0.45);
    text-decoration: none;
    color: var(--ink);
    transition: transform 220ms ease, border-color 220ms ease, box-shadow 220ms ease, background-color 220ms ease;
  }

  .row a:hover {
    color: var(--ink);
    transform: translateY(-3px);
    border-color: var(--ink);
    background: #fff;
    box-shadow: 0 18px 40px -24px rgba(21, 21, 21, 0.35);
  }

  .row-num {
    align-self: start;
    padding-top: 0.6rem;
  }

  .row-text {
    display: grid;
    gap: 0.75rem;
  }

  .row h3 {
    font-size: clamp(1.7rem, 3vw, 2.4rem);
  }

  .row p {
    color: var(--ink-2);
    max-width: 44rem;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0.25rem 0 0;
    padding: 0;
  }

  .chips li {
    font-family: var(--mono);
    font-size: 0.72rem;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    border: 1px solid var(--rule);
    color: var(--ink-2);
  }

  .row-art {
    color: var(--ink);
  }

  /* ---------- 4. AI ---------- */
  .ai {
    position: relative;
    overflow: hidden;
  }

  .ai-glow {
    position: absolute;
    width: 40rem;
    height: 40rem;
    right: -12rem;
    top: -14rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(229, 87, 78, 0.18), transparent 65%);
    pointer-events: none;
  }

  .ai-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .ai h2 {
    font-size: clamp(2rem, 4vw, 3.25rem);
    margin-block: 0.85rem 1.25rem;
  }

  .ai .lede {
    margin-bottom: 1.75rem;
  }

  .ai .console {
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.9), 0 0 0 1px rgba(236, 232, 225, 0.06);
  }

  .console-bar i {
    border-radius: 50%;
  }

  .sample {
    margin: 0;
    white-space: pre-wrap;
    word-break: break-word;
    min-height: 9rem;
  }

  .sample .prompt-text {
    color: var(--ink);
  }

  .sample .gen {
    color: var(--red);
  }

  /* ---------- 5. products ---------- */
  .products {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .product {
    display: grid;
    align-content: start;
    gap: 0.9rem;
    padding: 1.75rem;
    border-radius: 1.5rem;
    border: 1px solid var(--rule);
    background: rgba(255, 255, 255, 0.45);
    transition: transform 220ms ease, border-color 220ms ease, background-color 220ms ease;
  }

  .product:hover {
    transform: translateY(-3px);
    border-color: var(--ink);
    background: #fff;
  }

  .product header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .product h3 {
    font-size: 1.6rem;
  }

  .product p {
    color: var(--ink-2);
  }

  .product .pill {
    border-radius: 999px;
  }

  .product .pill::before {
    border-radius: 50%;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    font-family: var(--mono);
    font-size: 0.8125rem;
  }

  .links a,
  .all a {
    color: var(--red);
    text-decoration: none;
  }

  .all {
    margin-top: 2rem;
    font-family: var(--mono);
    font-size: 0.875rem;
  }

  /* ---------- 6. numbers ---------- */
  .big-numbers {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 0;
    border-top: 1px solid var(--ink);
  }

  .big-numbers > div {
    display: grid;
    gap: 0.35rem;
    padding: 1.75rem 1.5rem 1.5rem 0;
  }

  .big-numbers > div + div {
    padding-left: 1.5rem;
    border-left: 1px solid var(--rule);
  }

  .big {
    order: -1;
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(3.5rem, 8vw, 6rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .big-numbers > div:first-child .big {
    color: var(--red);
  }

  .big-numbers dt {
    font-weight: 500;
  }

  .src {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--grey);
  }

  /* ---------- 8. principles ---------- */
  .two-col {
    display: grid;
